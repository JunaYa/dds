{
  "name": "dds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "brand:generate": "node scripts/generate-brand.mjs",
    "brand:generate:macos": "node scripts/generate-macos-icon.mjs",
    "check:ui": "node scripts/check-ui-boundaries.mjs",
    "typecheck": "node scripts/check-ui-boundaries.mjs && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test scripts/android-env.test.mjs && vitest run",
    "dev:desktop": "tauri dev",
    "dev:mobile": "node scripts/dev-mobile.mjs",
    "build:desktop": "tauri build",
    "init:ios": "tauri ios init --ci",
    "dev:ios": "tauri ios dev",
    "start:ios:sim": "xcrun simctl launch booted com.dds.app",
    "start:ios:device": "xcrun devicectl device process launch --device \"JunaYa的iPhone\" com.junaya.littledays.dev",
    "build:ios": "tauri ios build",
    "build:ios:sim": "node scripts/build-ios-simulator.mjs",
    "init:android": "node scripts/init-android.mjs",
    "dev:android": "node scripts/android.mjs dev",
    "start:android:device": "adb -d shell am start -W -n com.dds.app/.MainActivity",
    "build:android": "node scripts/android.mjs build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@vita/styles": "workspace:*",
    "@vita/tokens": "workspace:*",
    "@vita/ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "5.9.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "30.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "5.1.0",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1 <27"
  }
}

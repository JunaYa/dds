<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@android:color/background_light">
    <TextView android:id="@+id/audio_category" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@android:color/black" android:textSize="16sp" />
    <TextView android:id="@+id/audio_title" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:maxLines="2" android:textColor="@android:color/black" android:textSize="18sp" />
    <Button android:id="@+id/audio_action" android:layout_width="match_parent" android:layout_height="48dp" />
</LinearLayout>
